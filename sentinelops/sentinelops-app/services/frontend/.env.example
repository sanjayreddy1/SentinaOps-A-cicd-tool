# Supabase (auth + console data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Console API origin. Leave empty for local Vite dev (the /api proxy in
# vite.config.ts forwards to localhost:8000). Set to http://localhost:8001
# when running the full stack via docker compose, or your deployed API URL.
VITE_API_BASE_URL=
